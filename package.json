{
  "name": "tug.js",
  "version": "0.1.1",
  "description": "simple drag and drop lib built using xstate and typescript",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "drag",
    "drop",
    "dragndrop",
    "drag and drop"
  ],
  "author": "Peter Hörmeyer",
  "license": "MIT",
  "dependencies": {
    "xstate": "^5.18.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@vitest/ui": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8",
    "happy-dom": "^15.11.7",
    "jsdom": "^25.0.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vite": "^7.2.6",
    "vitest": "^2.1.8"
  },
  "repository": {
    "url": "https://github.com/pinetoppeter/tug.js"
  }
}